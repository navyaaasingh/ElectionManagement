{
  "title": "Election Safety Fence Dashboard",
  "tags": ["election", "safety-fence"],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 30,
  "version": 2,
  "panels": [
    {
      "type": "heatmap",
      "title": "Terminal Heartbeat Heatmap",
      "targets": [
        {
          "expr": "terminal_offline_count",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "graph",
      "title": "Vote Velocity Per District (votes/hour)",
      "targets": [
        {
          "expr": "sum by (district_id) (vote_velocity_per_district)",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "xaxis": { "mode": "time" },
      "yaxes": [{ "format": "short" }, { "format": "short" }]
    },
    {
      "type": "graph",
      "title": "Fabric Latency p95 (ms)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(fabric_call_latency_ms_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "xaxis": { "mode": "time" },
      "yaxes": [{ "format": "ms" }, { "format": "short" }]
    },
    {
      "type": "graph",
      "title": "ML Anomaly Score (proxy via fraud alerts)",
      "targets": [
        {
          "expr": "increase(election_backend_fraud_alerts_total[5m])",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "xaxis": { "mode": "time" },
      "yaxes": [{ "format": "short" }, { "format": "short" }]
    },
    {
      "type": "stat",
      "title": "Outbox Pending",
      "targets": [
        {
          "expr": "outbox_pending",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 16 }
    },
    {
      "type": "stat",
      "title": "Dead Letters",
      "targets": [
        {
          "expr": "dead_letter_pending",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 16 }
    },
    {
      "type": "stat",
      "title": "Fabric Circuit Open",
      "targets": [
        {
          "expr": "fabric_circuit_open",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 16 }
    },
    {
      "type": "stat",
      "title": "Vote Cast Latency p95 (ms)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vote_cast_latency_ms_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 16 }
    },
    {
      "type": "stat",
      "title": "ML Service Healthy",
      "targets": [
        {
          "expr": "ml_service_healthy",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 22 }
    },
    {
      "type": "graph",
      "title": "Saga State Counts",
      "targets": [
        {
          "expr": "sum by (state) (vote_saga_state_count)",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 22 },
      "xaxis": { "mode": "time" },
      "yaxes": [{ "format": "short" }, { "format": "short" }]
    }
  ]
}
